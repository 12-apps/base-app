# base-app — every subsystem is OFF by default.
#
# Copy to `.env` and flip only what you need. Flag names and the parser live in
# `packages/features`; each host reads its own source:
#
#   apps/api    process.env.FEATURE_*        runtime
#   apps/events process.env.FEATURE_*        runtime
#   apps/spa    import.meta.env.VITE_FEATURE_*  build time (Vite inlines it)
#
# `1` and `true` mean on; anything else — including unset — means off.
#
# The SERVER's answer is the authoritative one. The SPA flag only decides
# whether the UI is mounted: it is inlined into the bundle, so it is a
# build-time switch and NOT a security boundary. Anything that must not be
# reachable stays behind the API's authorization checks either way.
#
# "Needs" names what is still missing before the flag does anything useful.
# See docs/BASE-REPO-READINESS.md for the full matrix.

# ── Infrastructure (all have working defaults) ────────────────────────────────

# PORT=3000                                # apps/api
# EVENTS_PORT=3010                         # apps/events
# SPA_ORIGIN=http://localhost:4001         # CORS origin for the dev SPAs
# API_ORIGIN=http://localhost:3000         # what Vite's dev proxy forwards to
# REDIS_URL=redis://localhost:6379         # unset → inline drivers, no Redis needed

# ── Ready today ───────────────────────────────────────────────────────────────

# Role-based access control (@12-apps/rbac). Mounts the permission context and
# <Can>. Needs: a server half to resolve the actor's permissions (12-13) — until
# then the set is empty and <Can> denies everything.
FEATURE_RBAC=
VITE_FEATURE_RBAC=

# Installable-app invite (@12-apps/pwa). Renders nothing until the browser
# offers an install prompt. Needs: a web app manifest endpoint (12-23).
VITE_FEATURE_PWA=

# ── Waiting on a package ──────────────────────────────────────────────────────

# Auth.js sign-in + session. Needs: createApiAuth/createWebAuth (12-12).
FEATURE_AUTH=
VITE_FEATURE_AUTH=

# Action audit. Needs: the @12-apps/audit package, which does not exist (12-14).
FEATURE_AUDIT=

# Notification inbox + preferences. Needs: @12-apps/notifications (12-15).
FEATURE_NOTIFICATIONS=
VITE_FEATURE_NOTIFICATIONS=

# Event system. Needs: the transports, publisher seam and outbox around
# @12-apps/realtime (12-16). apps/events is a placeholder until then.
FEATURE_EVENTS=
VITE_FEATURE_EVENTS=

# Entity history / recycle bin / drafts. Needs: the API + web halves of
# @12-apps/entity-lifecycle (12-17).
FEATURE_ENTITY_HISTORY=
VITE_FEATURE_ENTITY_HISTORY=

# Report builder. The package is complete and is the reference for every other
# port; it needs a database to mount against (12-33).
FEATURE_REPORTS=
VITE_FEATURE_REPORTS=

# Plan/feature entitlements. Needs: the API half that produces the snapshot
# (12-19).
FEATURE_ENTITLEMENTS=
VITE_FEATURE_ENTITLEMENTS=

# Background jobs. Needs: createApiJobs (12-22). Falls back to the inline driver
# when REDIS_URL is unset, so handlers run in-process.
FEATURE_JOBS=

# Uploads / object storage. Needs: @12-apps/storage (12-20).
FEATURE_STORAGE=
VITE_FEATURE_STORAGE=

# Error reporting. The browser half is installable now that this is a Vite SPA;
# it needs the served-DSN endpoint on the API side (12-21).
FEATURE_OBSERVABILITY=
VITE_FEATURE_OBSERVABILITY=

# Guided onboarding. Needs: createApiOnboarding + the OnboardingState model
# (12-23).
FEATURE_ONBOARDING=
VITE_FEATURE_ONBOARDING=

# MCP tool surface. Needs: the OAuth authorization-server routes and the
# McpConnection model (12-23).
FEATURE_MCP=

# Platform "act as" / preview-as-member. Needs: the impersonation port (12-24).
FEATURE_IMPERSONATION=
VITE_FEATURE_IMPERSONATION=
